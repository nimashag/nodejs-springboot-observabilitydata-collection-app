# Observability Dashboard Frontend - Environment Variables
# Copy this file to .env and update with your actual values

# Log Aggregation Service API URL
# Default: http://localhost:3005 (for local development)
# For production, use your nginx gateway URL or direct service URL
VITE_LOG_AGGREGATION_API_URL=http://localhost:3005

# Alert Agent Data Collection Service API URL
# Default: http://localhost:3008 (for local development)
# For production, use your nginx gateway URL or direct service URL
VITE_ALERT_AGENT_API_URL=http://localhost:3008

# General API Base URL (optional - used as fallback)
# If not set, the app will auto-detect based on hostname
# VITE_API_BASE_URL=http://localhost:31000

# API Key for authentication (optional)
# Only required if your backend services require API key authentication
# VITE_API_KEY=your-api-key-here
