{
  "name": "anomaly-detection-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "python scripts/run_realtime_pipeline.py --once",
    "start:once": "python scripts/run_realtime_pipeline.py --once",
    "start:watch": "python scripts/run_realtime_pipeline.py --interval 2",
    "start:no-email": "set ANOMALY_SEND_EMAIL=0 && python scripts/run_realtime_pipeline.py --interval 2",
    "api": "node api-server.js",
    "api:dev": "nodemon api-server.js",
    "preflight": "python scripts/preflight_check.py"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
