# Machine Learning / Data
# ========================
# Generated output files
outputs/
!outputs/.gitkeep

# Data directories (often large/temporary)
data/raw/*
data/processed/*
data/test/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/test/.gitkeep

# Keep CSV/merged structure but ignore contents
data/csv/*
data/merged/*
data/metrics/*
!data/csv/.gitkeep
!data/merged/.gitkeep
!data/metrics/.gitkeep

# Trained models (can be large)
models/*.joblib
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
!models/.gitkeep

# Model experiments
model_experiments/
!model_experiments/
!model_experiments/eval_models.py
!model_experiments/outputs/
!model_experiments/outputs/model_accuracy.json
!model_experiments/.gitkeep


